<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\FolderSync.Core\FolderSync.Core.csproj" />
    <ProjectReference Include="..\..\src\FolderSync.Platforms\FolderSync.Platforms.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- 多目标（方案 §4.1/§8.1）：net8.0 三平台可跑（Windows 专属套件编译期排除+运行时 SKIP）；
         net8.0-windows 供 Windows 本机/CI 跑全套（usn/diskfull 需要 WindowsIdentity/VHD） -->
    <TargetFrameworks>net8.0;net8.0-windows</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net8.0-windows'">
    <Compile Remove="UsnTests.cs" />
    <Compile Remove="DiskFullTests.cs" />
  </ItemGroup>

</Project>
