<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FolderSync.App.ViewModels"
        x:Class="FolderSync.App.Views.VersionBrowserWindow"
        x:DataType="vm:VersionBrowserViewModel"
        Title="版本库" Width="940" Height="560" MinWidth="720" MinHeight="400"
        WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="Auto,*,Auto" Margin="12">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <TextBlock Text="侧" VerticalAlignment="Center" FontSize="13"/>
            <ComboBox ItemsSource="{Binding SideOptions}" SelectedIndex="{Binding SideIndex}" Width="340"
                      AutomationProperties.Name="版本库侧"/>
            <Button Content="刷新" Padding="12,5" Click="BtnRefresh_Click"/>
            <TextBlock Text="{Binding StatsText}" VerticalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource TextSecondary}" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,12,*">
            <Grid RowDefinitions="Auto,*" Grid.Column="0">
                <TextBlock Grid.Row="0" Text="文件" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextTertiary}" Margin="0,0,0,4"/>
                <ListBox Grid.Row="1" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}"
                         SelectionChanged="LstFiles_SelectionChanged" DoubleTapped="LstFiles_DoubleTapped"
                         AutomationProperties.Name="版本文件列表">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:VersionBrowserViewModel+FileRow">
                            <StackPanel>
                                <TextBlock Text="{Binding RelPath}" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextTertiary}">
                                    <Run Text="{Binding VersionCount}"/> 版 · <Run Text="{Binding TotalSizeText}"/> · 最近 <Run Text="{Binding LatestTsShort}"/>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
            <Grid RowDefinitions="Auto,*" Grid.Column="2">
                <TextBlock Grid.Row="0" Text="{Binding VersionHeaderText}" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextTertiary}" Margin="0,0,0,4"/>
                <ListBox Grid.Row="1" ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}"
                         DoubleTapped="LstVersions_DoubleTapped"
                         AutomationProperties.Name="版本列表">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:VersionBrowserViewModel+VersionRow">
                            <StackPanel>
                                <TextBlock Text="{Binding TsShort}" FontSize="12.5"/>
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextTertiary}">
                                    <Run Text="{Binding SizeText}"/> · 原 mtime <Run Text="{Binding MtimeShort}"/>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource TextSecondary}" Margin="0,0,10,0"/>
            <Button Classes="primary" x:Name="BtnRestore" Content="还原到原位置" Padding="12,5" Click="BtnRestore_Click"
                    AutomationProperties.Name="还原到原位置"/>
            <Button x:Name="BtnSaveAs" Content="另存到…" Padding="12,5" Click="BtnSaveAs_Click"/>
            <Button Content="删除此版本" Padding="12,5" Click="BtnDelete_Click"/>
            <Button Content="清空全部" Padding="12,5" Click="BtnClearAll_Click"/>
            <Button Content="关闭" Padding="12,5" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
