<Window x:Class="FolderSync.App.VersionBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="版本库" Height="620" Width="940" MinWidth="720" MinHeight="420"
        Icon="assets/app.ico"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== 头部：侧选择 + 库统计 ===== -->
        <Border Grid.Row="0" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="侧" VerticalAlignment="Center" FontSize="13" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CmbSide" Width="220" FontSize="13" SelectionChanged="CmbSide_SelectionChanged"/>
                    <TextBlock x:Name="TxtStats" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="14,0,0,0"/>
                </StackPanel>
                <TextBlock/>
            </DockPanel>
        </Border>

        <!-- ===== 文件 / 版本 两栏 ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="文件（按最近版本时间排序）" FontSize="12" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" Margin="2,0,0,4"/>
                <ListView x:Name="LstFiles" FontSize="12" SelectionMode="Single"
                          SelectionChanged="LstFiles_SelectionChanged"
                          MouseDoubleClick="LstFiles_DoubleClick">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="相对路径" DisplayMemberBinding="{Binding RelPath}" Width="330"/>
                            <GridViewColumn Header="版本数" DisplayMemberBinding="{Binding VersionCount}" Width="60"/>
                            <GridViewColumn Header="合计大小" DisplayMemberBinding="{Binding TotalSizeText}" Width="90"/>
                            <GridViewColumn Header="最近版本" DisplayMemberBinding="{Binding LatestTsShort}" Width="150"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

            <DockPanel Grid.Column="2">
                <TextBlock x:Name="TxtVersionHeader" DockPanel.Dock="Top" Text="版本" FontSize="12" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" Margin="2,0,0,4"/>
                <ListView x:Name="LstVersions" FontSize="12" SelectionMode="Single"
                          MouseDoubleClick="LstVersions_DoubleClick">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="入库时间" DisplayMemberBinding="{Binding TsShort}" Width="160"/>
                            <GridViewColumn Header="大小" DisplayMemberBinding="{Binding SizeText}" Width="90"/>
                            <GridViewColumn Header="块数" DisplayMemberBinding="{Binding ChunkCount}" Width="50"/>
                            <GridViewColumn Header="原修改时间" DisplayMemberBinding="{Binding MtimeShort}" Width="160"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Grid>

        <!-- ===== 状态行 ===== -->
        <TextBlock Grid.Row="2" x:Name="TxtStatus" FontSize="12" Foreground="{DynamicResource Accent}" Margin="2,8,0,6" Text="选择文件查看历史版本"/>

        <!-- ===== 操作按钮 ===== -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnRestore" Content="还原到原位置" Padding="14,6" Margin="0,0,8,0" Style="{StaticResource BtnPrimary}" Click="BtnRestore_Click"/>
            <Button x:Name="BtnSaveAs" Content="另存到…" Padding="12,6" Margin="0,0,8,0" Click="BtnSaveAs_Click"/>
            <Button x:Name="BtnDelete" Content="删除此版本" Padding="12,6" Margin="0,0,8,0" Click="BtnDelete_Click"/>
            <Button x:Name="BtnClearAll" Content="清空全部版本…" Padding="12,6" Margin="0,0,8,0" Foreground="{DynamicResource Danger}"
                    ToolTip="永久删除当前侧版本库内的全部历史版本（不影响两侧同步内容）" Click="BtnClearAll_Click"/>
            <Button x:Name="BtnRefresh" Content="刷新" Padding="12,6" Margin="0,0,8,0" Click="BtnRefresh_Click"/>
            <Button Content="关闭" Padding="12,6" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
