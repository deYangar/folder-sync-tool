<Window x:Class="FolderSync.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="FolderSync — 本地文件夹同步" Height="780" Width="1200"
        Icon="assets/app.ico"
        MinHeight="560" MinWidth="960"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ 工具栏 ============ -->
        <Border Grid.Row="0" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="12,9">
                <Button x:Name="BtnNew" Style="{StaticResource BtnIconText}" Tag="&#xE109;" Content="新建任务" Click="BtnNew_Click"/>
                <Button x:Name="BtnEdit" Style="{StaticResource BtnIconText}" Tag="&#xE70F;" Content="编辑" Click="BtnEdit_Click"/>
                <Button x:Name="BtnDelete" Style="{StaticResource BtnIconText}" Tag="&#xE74D;" Content="删除" Foreground="{DynamicResource Danger}" Click="BtnDelete_Click"/>
                <Border Width="1" Height="22" Background="{DynamicResource Separator}" Margin="8,4,14,0"/>
                <Button x:Name="BtnAnalyze" Style="{StaticResource BtnPrimary}" Margin="0,0,8,0" Click="BtnAnalyze_Click">
                    <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="分析" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnSync" Style="{StaticResource BtnPrimary}" Margin="0,0,8,0" Click="BtnSync_Click">
                    <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="同步" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnCancel" Style="{StaticResource BtnIconText}" Content="停止" Click="BtnCancel_Click"
                        ToolTip="停掉正在执行的这一轮同步（手动/实时/定时触发都有效；不改变任务的监听状态）"/>
                <Button x:Name="BtnVerify" Style="{StaticResource BtnIconText}" Tag="&#xE73E;" Content="校验" Click="BtnVerify_Click"
                        ToolTip="对当前任务跑一轮只读深度校验（全量，不受任务设置的三档限制）：逐文件比对两侧内容哈希，检出磁盘静默损坏（位腐）。发现项标记待裁决，不自动覆盖"/>
                <Button x:Name="BtnToggleWatch" Style="{StaticResource BtnIconText}" Tag="&#xE769;" Content="停止实时监控"
                        Click="BtnToggleWatch_Click" Visibility="Collapsed"
                        ToolTip="暂停/恢复本任务的实时监听：卸载或重新挂载文件监控，写入任务启用状态（重启后保持）；正在同步的这一轮不受影响，手动「同步」仍可用"/>
                <Border Width="1" Height="22" Background="{DynamicResource Separator}" Margin="8,4,8,0"/>
                <Button x:Name="BtnOpenVersions" Style="{StaticResource BtnIconText}" Tag="&#xE8B7;" Content="浏览版本库" Click="BtnOpenVersions_Click"
                        ToolTip="查看历史版本：按文件列出版本，可还原到原位置 / 另存 / 删除 / 清空全部"/>
                <Button x:Name="BtnFailedItems" Style="{StaticResource BtnIconText}" Tag="&#xE7BA;" Content="上次失败明细" Click="BtnFailedItems_Click"
                        ToolTip="查看最近一轮执行失败明细并重试"/>
                <Button x:Name="BtnHistory" Style="{StaticResource BtnIconText}" Tag="&#xE81C;" Content="历史" Click="BtnHistory_Click"
                        ToolTip="查看本任务最近 100 轮运行历史：触发/状态/计数/增量节省/耗时/均速，可导出 CSV、打开轮末报告"/>
                <Border Width="1" Height="22" Background="{DynamicResource Separator}" Margin="8,4,14,0"/>
                <Button x:Name="BtnSettings" Style="{StaticResource BtnIconText}" Tag="&#xE713;" Content="设置" Click="BtnSettings_Click"
                        ToolTip="软件设置：开机自启、自启时最小化"/>
            </StackPanel>
        </Border>

        <!-- ============ 主体 ============ -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左：任务列表 -->
            <Border Grid.Column="0" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="任务" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextTertiary}" Margin="14,10,0,6"/>
                    <ListBox Grid.Row="1" x:Name="LstJobs" Style="{StaticResource JobList}"
                             SelectionChanged="LstJobs_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="9" Height="9" Fill="{Binding StatusBrush}" Margin="0,0,7,0" VerticalAlignment="Center"
                                                 ToolTip="{Binding StatusText}"/>
                                        <TextBlock Text="{Binding Job.Name}" FontWeight="SemiBold" FontSize="13.5"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="180"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextTertiary}" FontSize="11.5"
                                               Margin="16,3,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 右：详情 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 文件夹卡片 -->
                <Grid Grid.Row="0" Margin="2,2,2,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{DynamicResource TreeAltBg}" BorderBrush="{DynamicResource LeftBand}" BorderThickness="1.5" CornerRadius="9" Padding="12,9">
                        <!-- DockPanel 而非横向 StackPanel：后者给子元素无限宽度，TextTrimming 永不触发
                             （表现为超长路径被硬裁断、无省略号）；LastChild 填剩余空间拿到有限测量宽度 -->
                        <DockPanel>
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="26" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0"
                                       DockPanel.Dock="Left"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TxtLeftPath" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource LeftBandText}"
                                           TextTrimming="CharacterEllipsis" Text="未选择任务"/>
                                <TextBlock x:Name="TxtLeftMeta" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0"
                                           TextTrimming="CharacterEllipsis" Text=""/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtDirArrow" Text="→" FontSize="28" FontWeight="Bold"
                                   Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtDirText" Text="" FontSize="11" Foreground="{DynamicResource TextTertiary}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="2" Background="{DynamicResource SuccessBg}" BorderBrush="{DynamicResource SuccessBg}" BorderThickness="1.5" CornerRadius="9" Padding="12,9">
                        <!-- 同左侧卡片：DockPanel 让 TextTrimming 真正生效（省略号截断） -->
                        <DockPanel>
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="26" Foreground="{DynamicResource Success}" VerticalAlignment="Center" Margin="0,0,10,0"
                                       DockPanel.Dock="Left"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TxtRightPath" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Success}"
                                           TextTrimming="CharacterEllipsis" Text="—"/>
                                <TextBlock x:Name="TxtRightMeta" FontSize="11.5" Foreground="{DynamicResource Success}" Margin="0,3,0,0"
                                           TextTrimming="CharacterEllipsis" Text=""/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- 筛选标签 -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="2,0,2,8">
                    <RadioButton x:Name="FilterAll" Style="{StaticResource FilterTab}" GroupName="PlanFilter" Tag="all" Checked="Filter_Changed" IsChecked="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="☰ 全部" VerticalAlignment="Center"/>
                            <Border Background="{DynamicResource BadgeGrayBg}" CornerRadius="9" Padding="7,1" Margin="7,0,0,0">
                                <TextBlock x:Name="CntAll" Text="0" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                            </Border>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="FilterChanged" Style="{StaticResource FilterTab}" GroupName="PlanFilter" Tag="changed" Checked="Filter_Changed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⇄ 所有变更" VerticalAlignment="Center"/>
                            <Border CornerRadius="9" Padding="7,1" Margin="7,0,0,0" Background="{DynamicResource RightBand}">
                                <TextBlock x:Name="CntChanged" Text="0" FontSize="11" Foreground="{DynamicResource RightBandText}" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="FilterCreate" Style="{StaticResource FilterTab}" GroupName="PlanFilter" Tag="create" Checked="Filter_Changed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⇢ 新建复制" VerticalAlignment="Center"/>
                            <Border CornerRadius="9" Padding="7,1" Margin="7,0,0,0" Background="{DynamicResource SuccessBg}">
                                <TextBlock x:Name="CntCreate" Text="0" FontSize="11" Foreground="{DynamicResource Success}" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="FilterUpdate" Style="{StaticResource FilterTab}" GroupName="PlanFilter" Tag="update" Checked="Filter_Changed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⟳ 更新覆盖" VerticalAlignment="Center"/>
                            <Border CornerRadius="9" Padding="7,1" Margin="7,0,0,0" Background="{DynamicResource RowHoverBg}">
                                <TextBlock x:Name="CntUpdate" Text="0" FontSize="11" Foreground="{DynamicResource Accent}" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="FilterDelete" Style="{StaticResource FilterTab}" GroupName="PlanFilter" Tag="delete" Checked="Filter_Changed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✕ 删除" VerticalAlignment="Center"/>
                            <Border CornerRadius="9" Padding="7,1" Margin="7,0,0,0" Background="{DynamicResource DangerBg}">
                                <TextBlock x:Name="CntDelete" Text="0" FontSize="11" Foreground="{DynamicResource Danger}" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="FilterConflict" Style="{StaticResource FilterTab}" GroupName="PlanFilter" Tag="conflict" Checked="Filter_Changed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠ 冲突" VerticalAlignment="Center"/>
                            <Border CornerRadius="9" Padding="7,1" Margin="7,0,0,0" Background="{DynamicResource ConflictRowBg}">
                                <TextBlock x:Name="CntConflict" Text="0" FontSize="11" Foreground="{DynamicResource WarningDeep}" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="FilterSkip" Style="{StaticResource FilterTab}" GroupName="PlanFilter" Tag="skip" Checked="Filter_Changed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏸ 已跳过" VerticalAlignment="Center"/>
                            <Border CornerRadius="9" Padding="7,1" Margin="7,0,0,0" Background="{DynamicResource BadgeGrayBg}">
                                <TextBlock x:Name="CntSkip" Text="0" FontSize="11" Foreground="{DynamicResource TextTertiary}" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- 树形对照表 -->
                <Border Grid.Row="2" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Margin="2,0">
                    <DataGrid x:Name="GridPlan" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserSortColumns="False" CanUserResizeRows="False"
                              SelectionMode="Single" HeadersVisibility="Column"
                              BorderThickness="0" RowHeight="28"
                              MouseLeftButtonUp="GridPlan_RowClick">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="项目（相对路径）" Width="*" MinWidth="240">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{Binding IndentWidth}"/>
                                                <ColumnDefinition Width="18"/>
                                                <ColumnDefinition Width="26"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <ToggleButton Grid.Column="1" Style="{StaticResource TreeToggle}"
                                                          IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                          Click="Expander_Click"
                                                          Visibility="{Binding HasChildren, Converter={StaticResource BoolVis}}"
                                                          HorizontalAlignment="Left"/>
                                            <Border Grid.Column="1" Width="16" Visibility="{Binding IsLeaf, Converter={StaticResource BoolVis}}"/>
                                            <Image Grid.Column="2" Source="{Binding Icon}" Width="20" Height="20"
                                                   VerticalAlignment="Center" Stretch="Uniform"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Name}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" FontSize="12.5"
                                                       Foreground="{Binding NameBrush}"
                                                       Cursor="Hand"
                                                       ToolTip="{Binding FullPath}"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="左 · 大小" Width="92" Binding="{Binding LeftSizeText}"
                                                CellStyle="{StaticResource LeftColCell}"/>
                            <DataGridTextColumn Header="左 · 日期" Width="126" Binding="{Binding LeftMtimeText}"
                                                CellStyle="{StaticResource LeftColCell}"/>
                            <DataGridTemplateColumn Header="左" Width="58">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Button Style="{StaticResource CellActionBtn}" Tag="{Binding}"
                                                    Click="LeftAction_Click"
                                                    Visibility="{Binding IsLeaf, Converter={StaticResource BoolVis}}"
                                                    ToolTip="点击：跳过 / 恢复；冲突行点此=保留左侧">
                                                <TextBlock Text="{Binding LeftActionGlyph}" FontSize="15" FontWeight="Bold"
                                                           FontFamily="Segoe UI, Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           Foreground="{Binding LeftActionBrush}"/>
                                            </Button>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                        Visibility="{Binding HasChildren, Converter={StaticResource BoolVis}}">
                                                <TextBlock Text="{Binding AggLeftInText}" FontSize="11.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Accent}" Visibility="{Binding HasLeftIn, Converter={StaticResource BoolVis}}"/>
                                                <TextBlock Text="{Binding AggLeftDelText}" FontSize="11.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Danger}" Visibility="{Binding HasLeftDel, Converter={StaticResource BoolVis}}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="右" Width="58">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Button Style="{StaticResource CellActionBtn}" Tag="{Binding}"
                                                    Click="RightAction_Click"
                                                    Visibility="{Binding IsLeaf, Converter={StaticResource BoolVis}}"
                                                    ToolTip="点击：跳过 / 恢复；冲突行点此=保留右侧">
                                                <TextBlock Text="{Binding RightActionGlyph}" FontSize="15" FontWeight="Bold"
                                                           FontFamily="Segoe UI, Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           Foreground="{Binding RightActionBrush}"/>
                                            </Button>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                        Visibility="{Binding HasChildren, Converter={StaticResource BoolVis}}">
                                                <TextBlock Text="{Binding AggRightInText}" FontSize="11.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Success}" Visibility="{Binding HasRightIn, Converter={StaticResource BoolVis}}"/>
                                                <TextBlock Text="{Binding AggRightDelText}" FontSize="11.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Danger}" Visibility="{Binding HasRightDel, Converter={StaticResource BoolVis}}"/>
                                                <TextBlock Text="{Binding AggConflictText}" FontSize="11.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Warning}" Visibility="{Binding HasConflict, Converter={StaticResource BoolVis}}"/>
                                                <TextBlock Text="{Binding AggMoveText}" FontSize="11.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Teal}" Visibility="{Binding HasMove, Converter={StaticResource BoolVis}}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="右 · 日期" Width="126" Binding="{Binding RightMtimeText}"
                                                CellStyle="{StaticResource RightColCell}"/>
                            <DataGridTextColumn Header="右 · 大小" Width="92" Binding="{Binding RightSizeText}"
                                                CellStyle="{StaticResource RightColCell}"/>
                            <DataGridTextColumn Header="说明" Width="190" Binding="{Binding NoteText}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
                                        <Setter Property="FontSize" Value="11.5"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="6,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConflictRow}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource WarningBg}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSkippedRow}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </Border>

                <!-- 冲突裁决栏 -->
                <Border Grid.Row="3" x:Name="SpConflict" Background="{DynamicResource WarningBg}" BorderBrush="{DynamicResource WarningBg}" BorderThickness="1"
                        CornerRadius="7" Padding="10,7" Margin="2,8,2,0" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠ 存在待裁决冲突：选中行后点行内图标，或用下方按钮 →" VerticalAlignment="Center"
                                   Foreground="{DynamicResource WarningDeep}" FontSize="12.5" Margin="0,0,10,0"/>
                        <Button x:Name="BtnKeepLeft" Content="保留左侧" Padding="12,4" Margin="0,0,6,0" Click="BtnKeepLeft_Click"/>
                        <Button x:Name="BtnKeepRight" Content="保留右侧" Padding="12,4" Margin="0,0,6,0" Click="BtnKeepRight_Click"/>
                        <Button x:Name="BtnSkipConflict" Content="跳过" Padding="12,4" Margin="0,0,10,0" Click="BtnSkipConflict_Click"/>
                        <Button x:Name="BtnResolveRun" Style="{StaticResource BtnPrimary}" Content="执行已裁决项"
                                Padding="14,4" Click="BtnResolveRun_Click"/>
                    </StackPanel>
                </Border>

                <!-- 进度 -->
                <Border Grid.Row="4" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8"
                        Padding="12,8" Margin="2,8,2,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                            <TextBlock x:Name="Step1" Text="① 扫描左侧" FontSize="12" Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center"/>
                            <TextBlock Text="—" FontSize="12" Foreground="{DynamicResource ProgressBg}" Margin="10,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="Step2" Text="② 扫描右侧" FontSize="12" Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center"/>
                            <TextBlock Text="—" FontSize="12" Foreground="{DynamicResource ProgressBg}" Margin="10,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="Step3" Text="③ 对比差异" FontSize="12" Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center"/>
                            <TextBlock Text="—" FontSize="12" Foreground="{DynamicResource ProgressBg}" Margin="10,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="Step4" Text="④ 同步执行" FontSize="12" Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid>
                            <ProgressBar x:Name="PbProgress" Height="14" Minimum="0" Maximum="100" Value="0"
                                         Background="{DynamicResource BadgeGrayBg}" BorderThickness="0" Foreground="{DynamicResource Accent}"/>
                        </Grid>
                        <TextBlock x:Name="TxtProgress" Margin="2,5,0,0" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                   TextTrimming="CharacterEllipsis" Text="就绪"/>
                    </StackPanel>
                </Border>

                <!-- 日志：整体只读 TextBox，任意跨行/行内拖选，Ctrl+A/Ctrl+C 原生可用 -->
                <Border Grid.Row="5" Background="{DynamicResource LogBg}" CornerRadius="8" Margin="2,8,2,2" Height="92">
                    <TextBox x:Name="TxtLog" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                             FontFamily="Consolas, Microsoft YaHei UI" FontSize="11.5"
                             Background="Transparent" BorderThickness="0" Foreground="{DynamicResource LogFg}"
                             Margin="6,4" Cursor="IBeam" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <TextBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="复制选中内容" Click="LogCopySelected_Click" InputGestureText="Ctrl+C"/>
                                <MenuItem Header="复制全部日志" Click="LogCopyAll_Click"/>
                                <Separator/>
                                <MenuItem Header="导出日志到文件…" Click="LogExport_Click"/>
                                <MenuItem Header="清空日志" Click="LogClear_Click"/>
                            </ContextMenu>
                        </TextBox.ContextMenu>
                    </TextBox>
                </Border>
            </Grid>
        </Grid>

        <!-- ============ 状态栏 ============ -->
        <StatusBar Grid.Row="2" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock x:Name="TxtStatus" Text="就绪" FontSize="12" Foreground="{DynamicResource BadgeGrayFg}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
