<Window x:Class="FolderSync.App.JobEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="任务设置" Width="660" MinWidth="620" MinHeight="380"
        SizeToContent="Height"
        Icon="assets/app.ico"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 内容超窗时可滚动，按钮钉在滚动区外永远可见 -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
        <!-- ===== 基本信息 ===== -->
        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="基本信息" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="0,0,0,10"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="任务名称" VerticalAlignment="Center" FontSize="13"/>
                    <TextBox Grid.Column="1" x:Name="TxtName"/>
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="左侧文件夹" VerticalAlignment="Center" FontSize="13"/>
                    <TextBox Grid.Column="1" x:Name="TxtLeft" Margin="0,0,8,0"/>
                    <Button Grid.Column="2" Content="浏览…" Padding="12,5" Click="BrowseLeft_Click"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="右侧文件夹" VerticalAlignment="Center" FontSize="13"/>
                    <TextBox Grid.Column="1" x:Name="TxtRight" Margin="0,0,8,0"/>
                    <Button Grid.Column="2" Content="浏览…" Padding="12,5" Click="BrowseRight_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ===== 同步方式与触发 ===== -->
        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="同步方式与触发" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="0,0,0,10"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="78"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="方向" VerticalAlignment="Center" FontSize="13"/>
                    <ComboBox Grid.Column="1" x:Name="CmbDirection" SelectedIndex="0" VerticalAlignment="Center"
                              ToolTip="镜像：源覆盖目标，目标较新时反向回写源（新者胜）或按严格镜像一律源覆盖。&#10;备份：只从源复制到目标（源新才覆盖），永不反向修改源、永不删除源——适合保护工作目录不被同步改动">
                        <ComboBoxItem Content="左 → 右（镜像）"/>
                        <ComboBoxItem Content="右 → 左（镜像）"/>
                        <ComboBoxItem Content="双向同步（⇄）"/>
                        <ComboBoxItem Content="左 → 右（备份）"/>
                        <ComboBoxItem Content="右 → 左（备份）"/>
                    </ComboBox>
                    <TextBlock Grid.Column="2" Text="触发" VerticalAlignment="Center" FontSize="13" Margin="10,0,0,0"/>
                    <ComboBox Grid.Column="3" x:Name="CmbTrigger" SelectedIndex="0" VerticalAlignment="Center">
                        <ComboBoxItem Content="手动"/>
                        <ComboBoxItem Content="实时监听"/>
                        <ComboBoxItem Content="定时间隔"/>
                        <ComboBoxItem Content="定时（指定时刻）"/>
                    </ComboBox>
                </Grid>
                <StackPanel x:Name="PnlSchedule" Orientation="Horizontal" Visibility="Collapsed" Margin="0,2,0,8"
                            ToolTip="到点自动同步（本地时区；调度器每 30 秒检查一次，误差 ≤30 秒）。关机错过的时刻由启动补跑兜底（需保持「任务启用」+「开机自启恢复」）">
                    <TextBlock Text="时刻" VerticalAlignment="Center" FontSize="13"/>
                    <ComboBox x:Name="CmbSchedHour" Width="58" Margin="8,0,4,0" VerticalAlignment="Center"/>
                    <TextBlock Text=":" VerticalAlignment="Center" FontSize="13" Margin="0,0,4,0"/>
                    <ComboBox x:Name="CmbSchedMinute" Width="58" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <CheckBox x:Name="ChkSchedDaily" Content="每天" VerticalAlignment="Center" Margin="0,0,10,0"
                              IsChecked="True" Checked="ChkSchedDaily_Changed" Unchecked="ChkSchedDaily_Changed"/>
                    <StackPanel Orientation="Horizontal" x:Name="PnlSchedWeek" IsEnabled="False" VerticalAlignment="Center">
                        <CheckBox x:Name="ChkD1" Content="一" Margin="0,0,6,0" IsChecked="True"/>
                        <CheckBox x:Name="ChkD2" Content="二" Margin="0,0,6,0"/>
                        <CheckBox x:Name="ChkD3" Content="三" Margin="0,0,6,0"/>
                        <CheckBox x:Name="ChkD4" Content="四" Margin="0,0,6,0"/>
                        <CheckBox x:Name="ChkD5" Content="五" Margin="0,0,6,0"/>
                        <CheckBox x:Name="ChkD6" Content="六" Margin="0,0,6,0"/>
                        <CheckBox x:Name="ChkD7" Content="日" Margin="0,0,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel x:Name="PnlConflictPolicy" Orientation="Horizontal" Visibility="Collapsed" Margin="0,2,0,8"
                            ToolTip="双向同步时两侧同名文件都被修改，按此策略自动裁决。&#10;三种败者去向三选一：版本保留（旧版入版本库）/ 冲突副本（败者改名 .sync-conflict-时间戳 留在原目录）/ 手动裁决">
                    <TextBlock Text="冲突策略" VerticalAlignment="Center" FontSize="13" Width="84"/>
                    <ComboBox x:Name="CmbConflictPolicy" Width="220" SelectedIndex="0" VerticalAlignment="Center">
                        <ComboBoxItem Content="最新修改日期优先"/>
                        <ComboBoxItem Content="文件大小优先"/>
                        <ComboBoxItem Content="手动裁决（不自动覆盖）"/>
                        <ComboBoxItem Content="冲突副本（败者改名保留）"/>
                    </ComboBox>
                </StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="78"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="PnlInterval" Orientation="Horizontal" Visibility="Collapsed" Grid.Column="1">
                        <TextBlock Text="间隔" VerticalAlignment="Center" FontSize="13" Margin="0,0,8,0"/>
                        <TextBox x:Name="TxtInterval" Text="2" Width="70"/>
                        <ComboBox x:Name="CmbIntervalUnit" SelectedIndex="0" Width="82" VerticalAlignment="Center" Margin="6,0,0,0">
                            <ComboBoxItem Content="小时"/>
                            <ComboBoxItem Content="分钟"/>
                            <ComboBoxItem Content="秒"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Grid.Column="3" x:Name="DebouncePanel">
                        <TextBlock x:Name="LblDebounce" Text="去抖(秒)" VerticalAlignment="Center" FontSize="13"
                                   Margin="10,0,8,0" Visibility="Collapsed"/>
                        <TextBox x:Name="TxtDebounce" Text="10" Width="90" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ===== 选项 ===== -->
        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12">
            <StackPanel>
                <TextBlock Text="选项" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="0,0,0,8"/>
                <Grid Margin="0,2,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="排除规则" VerticalAlignment="Center" FontSize="13"
                               ToolTip="分号分隔；支持通配符（*.tmp）或路径段名（.git）"/>
                    <TextBox Grid.Column="1" x:Name="TxtExclude" Text="Thumbs.db; ._gstmp; .DS_Store"/>
                </Grid>
                <Grid Margin="0,2,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="版本保留" VerticalAlignment="Center" FontSize="13"
                               ToolTip="覆盖或删除文件前，旧版本移入任务根下 _FolderSync_Versions（按批次保留原相对路径）"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,10,0">
                        <TextBox x:Name="TxtVersionKeep" Text="5" Width="56" VerticalAlignment="Center"/>
                        <TextBlock Text=" 代" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="4,0,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource TextTertiary}" TextTrimming="CharacterEllipsis"
                               Text="0 = 关闭；旧版存于 _FolderSync_Versions，主窗口可打开/清空"/>
                </Grid>
                <CheckBox x:Name="ChkDeltaSync" Content="块级增量传输：只传输目标侧缺少的数据块"
                          ToolTip="大文件小改动时显著减少传输量（适合 NAS/移动盘/网络目标）；切块对比后始终做全文校验，校验不过自动整文件复制，绝不出错文件。小于 4MB 的文件自动走整文件"
                          IsChecked="True"/>
                <CheckBox x:Name="ChkAutoRetry" Content="失败自动重试：文件被占用等瞬时错误轮末自动重试（2s/10s/30s 三轮）"
                          ToolTip="复制/删除撞上文件被占用（共享冲突）、网络抖动等瞬时错误时，不再直接记失败，本轮结束后自动退避重试，三轮仍失败才进失败列表。实时任务本就有下一轮兜底，此开关主要救手动/定时同步"
                          IsChecked="True"/>
                <CheckBox x:Name="ChkMoveDetect" Content="移动/重命名检测：识别被移动的文件，目标侧直接改名代替重拷"
                          ToolTip="一侧删除+同侧出现的内容与大小/修改时间完全一致的文件对，识别为移动，目标侧内部改名瞬时完成（不重新复制、版本库零增长）。需要开启镜像删除才生效；大小或时间对不上或有歧义时按普通复制处理，绝不误判"
                          IsChecked="True"/>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="ChkCopyVerify" Content="复制后复核（写完读回验哈希）"
                              ToolTip="每个文件复制完成后读回目标全文哈希与源比对，不符记失败（介质静默损坏信号）。代价：目标侧全部内容多读一遍，速度约减半"
                              Margin="0,0,10,0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                ToolTip="分析时对「两侧大小/时间一致（判无差异）」的文件比对内容哈希，检出磁盘静默损坏（位腐）。发现项标记人工裁决。代价：每轮同步按档位多读两侧内容一遍">
                        <TextBlock Text="深度校验" VerticalAlignment="Center" FontSize="13"/>
                        <ComboBox x:Name="CmbDeepVerify" Width="118" SelectedIndex="0" VerticalAlignment="Center" Margin="6,0,0,0">
                            <ComboBoxItem Content="关"/>
                            <ComboBoxItem Content="仅 ≥50MB 文件"/>
                            <ComboBoxItem Content="全量"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,10,0"
                                ToolTip="复制/归档趟多 worker 并行（删除趟保持串行）。默认 2；机械盘或高并发小文件场景可设 1（串行旧路径）">
                        <TextBlock Text="并行复制" VerticalAlignment="Center" FontSize="13"/>
                        <ComboBox x:Name="CmbCopyWorkers" Width="70" SelectedIndex="1" VerticalAlignment="Center" Margin="6,0,0,0">
                            <ComboBoxItem Content="1（串行）"/>
                            <ComboBoxItem Content="2"/>
                            <ComboBoxItem Content="3"/>
                            <ComboBoxItem Content="4"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>
                <CheckBox x:Name="ChkStrictMirror" Content="严格镜像：两边都改过时一律以源覆盖目标（关 = 保留较新一侧）"
                          ToolTip="单向任务有效。默认关：源和目标都修改过时，保留较新版本（不反向覆盖源）；开启后目标侧的修改永远被源覆盖，行为等同 GoodSync 的严格镜像"
                          Visibility="Collapsed"/>
                <CheckBox x:Name="ChkMirrorDelete" Content="镜像删除：源里已删除的文件同步删除目标副本（关 = 目标保留多余文件）"
                          ToolTip="首次运行建议关闭，确认差异列表无误后再开启"/>
                <CheckBox x:Name="ChkRecycle" Content="删除进回收站（网络路径除外）" IsChecked="True"/>
                <CheckBox x:Name="ChkEnabled" Content="任务启用（关闭后不参与实时/定时自动同步）" IsChecked="True"/>
            </StackPanel>
        </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== 按钮（在滚动区外，永不消失） ===== -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="确定" Width="96" Padding="0,7" Style="{StaticResource BtnPrimary}" Click="Ok_Click" IsDefault="True"/>
            <Button Content="取消" Width="96" Padding="0,7" Margin="10,0,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
